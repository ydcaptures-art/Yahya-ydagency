# ---------------------------------------------------------------------------
# Database (Supabase → Project Settings → Database → Connection string)
# Use the "Transaction pooler" URI (port 6543) on serverless hosts like Vercel.
# SERVER-ONLY. Never prefix with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/salon

# Which tenant this deployment serves (salons.slug)
SALON_SLUG=maison-aurelle

# Public URL of the site (used in emails, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to protect the reminder cron endpoint (any long random string)
CRON_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Email — Resend (https://resend.com). Leave empty to disable email sending;
# notifications are then logged as "skipped" in the dashboard, never faked.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Maison Aurelle <bookings@yourdomain.com>"

# ---------------------------------------------------------------------------
# WhatsApp — Meta WhatsApp Business Cloud API (official).
# Business-initiated messages require pre-approved message templates.
# Leave empty to disable.
# ---------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Template names (each approved in tr, en and de). Body parameters, in order:
# {{1}} customer first name, {{2}} salon name, {{3}} date, {{4}} time, {{5}} branch, {{6}} reference
WHATSAPP_TEMPLATE_CONFIRMATION=booking_confirmation
WHATSAPP_TEMPLATE_REMINDER=booking_reminder
WHATSAPP_TEMPLATE_CANCELLATION=booking_cancellation
WHATSAPP_TEMPLATE_RESCHEDULE=booking_rescheduled

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Instagram Graph API long-lived token — shows the real latest posts on the homepage.
# Without it, the Instagram section shows the salon gallery linking to the profile.
INSTAGRAM_ACCESS_TOKEN=
# Link for the "Website by YD Agency" footer credit
NEXT_PUBLIC_AGENCY_URL=
# Supabase Storage for image uploads from the dashboard (SERVER-ONLY keys).
# Create a PUBLIC bucket named "salon-media" (or set SUPABASE_STORAGE_BUCKET).
# Without these, the dashboard accepts image URLs instead of uploads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=salon-media
